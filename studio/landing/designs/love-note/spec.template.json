 },
 "behaviour": {
  "template": "story_player",
  "summary": "Your recorded voice notes live on its microSD card. When you send a message from your phone on the home Wi-Fi, the heart glows a soft warm white. She taps the heart to hear your note; tap again to stop. The small speaker in the base plays it at a gentle volume.",
  "settings": {
   "capture_mode": "none",
   "night_light": true,
   "night_light_minutes": 30,
   "night_light_brightness": 18,
   "night_light_color": "#FFD9B0",
   "story_order": "sequential"
  }
 },
 "safety": {
  "flags": [
   "NIGHT_USE"
  ],
  "notes": "No microphone: it only plays notes you load. Glow brightness capped in firmware. Local Wi-Fi control only; nothing is sent to a cloud. External certified USB-C supply."
 }
