# Upload only what the gstudio-web image needs (deploy/web.sh passes --ignore-file).
**/_out/
**/node_modules/
**/dist/
**/.pio/
**/__pycache__/
**/*.pyc
**/.venv/
.git/
/builder/
/tools/
# engine/gstudio/cad/ ships: its pure-Python footprints let the web design check catch kit overlaps the builder
# would reject (CadQuery is imported lazily and is not installed in the web image). Its tests stay out.
engine/gstudio/cad/tests/
engine/gstudio/pcb/
engine/gstudio/firmware/
engine/gstudio/manual/
engine/gstudio/order/
engine/gstudio/docs_gen/
engine/tests/
examples/*/_out/
web/server/tests/
# The landing page and its media are a separate service (deploy/landing.sh); the image never copies them.
/site/
/landing/
